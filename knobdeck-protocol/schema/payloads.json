{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Payloads",
  "description": "Typed payloads carried in event.payload, host_call.params and result.value.",
  "$defs": {
    "ActionResult": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The `request` this answers."
        },
        "ok": {
          "type": "boolean"
        },
        "result": {
          "description": "When `ok`."
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "description": "When not `ok`: a message for the user."
        },
        "unsupported": {
          "type": "boolean",
          "description": "When not `ok` because the app has no API for this action."
        }
      },
      "required": [
        "id",
        "ok"
      ],
      "description": "The body of a companion's `response`: how an action went."
    },
    "AppState": {
      "type": "object",
      "properties": {
        "os": {
          "type": "string",
          "description": "`windows`, `macos` or `linux`."
        },
        "host_version": {
          "type": "string"
        },
        "dial_open": {
          "type": "boolean",
          "description": "Whether the dial is on screen."
        }
      },
      "required": [
        "os",
        "host_version",
        "dial_open"
      ],
      "description": "The answer to the `app_state` host call."
    },
    "DialOpened": {
      "type": "object",
      "properties": {
        "profile_id": {
          "type": "string",
          "description": "The profile the dial shows."
        }
      },
      "required": [
        "profile_id"
      ],
      "description": "Payload of the `dial_opened` event."
    },
    "Discovery": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "port": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "description": "The hub's loopback port."
        },
        "path": {
          "type": "string",
          "description": "[`WS_PATH`]."
        },
        "token": {
          "type": "string",
          "description": "Sent back in `hello.token`. A companion that can't read files (a browser extension)\nconnects without it, from an extension origin."
        }
      },
      "required": [
        "protocol",
        "port",
        "path",
        "token"
      ],
      "description": "What the hub writes to [`DISCOVERY_FILE`]."
    },
    "Link": {
      "type": "object",
      "properties": {
        "link": {
          "type": "string",
          "description": "The hub's id for this link; pass it to `companion_request`."
        },
        "instance": {
          "type": "string"
        },
        "app": {
          "type": "string"
        },
        "app_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "link",
        "instance",
        "app"
      ],
      "description": "One connected companion, as the plugin sees it (`companion_connected`, `companion_links`)."
    },
    "LinkEvent": {
      "type": "object",
      "properties": {
        "link": {
          "type": "string"
        },
        "event": {
          "type": "string",
          "description": "The companion's event name."
        },
        "payload": {
          "default": null
        }
      },
      "required": [
        "link",
        "event"
      ],
      "description": "Payload of `companion_event`."
    },
    "LinkGone": {
      "type": "object",
      "properties": {
        "link": {
          "type": "string"
        }
      },
      "required": [
        "link"
      ],
      "description": "Payload of `companion_disconnected`."
    },
    "LinkRequest": {
      "type": "object",
      "properties": {
        "link": {
          "type": [
            "string",
            "null"
          ],
          "description": "A link from `companion_connected` / `companion_links`; absent: the most recently\nconnected link of this plugin."
        },
        "action": {
          "type": "string"
        },
        "params": {
          "default": null
        },
        "timeout_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "description": "How long to wait for the companion (default 5000, at most 30000)."
        }
      },
      "required": [
        "action"
      ],
      "description": "`params` of the `companion_request` host call."
    },
    "Notify": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "description": "One short sentence. The host may shorten long text."
        },
        "level": {
          "type": [
            "string",
            "null"
          ],
          "description": "`info` (default) or `error`. Unknown values read as `info`."
        }
      },
      "required": [
        "message"
      ],
      "description": "`params` of the `notify` host call."
    },
    "OpenDial": {
      "type": "object",
      "properties": {
        "profile_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "The dial profile to show. Absent: the one the user's auto-open rules pick, as the dial\nkeybind does."
        }
      },
      "description": "`params` of the `open_dial` host call."
    }
  }
}
