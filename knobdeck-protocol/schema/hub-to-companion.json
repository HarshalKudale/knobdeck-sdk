{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HubMsg",
  "description": "A frame the hub sends to a companion.",
  "oneOf": [
    {
      "description": "`hello` was accepted; the link is up.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ready"
        },
        "protocol": {
          "description": "The companion protocol the hub speaks.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "link": {
          "description": "The id the plugin knows this link by.",
          "type": "string"
        },
        "host_version": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "protocol",
        "link",
        "host_version"
      ]
    },
    {
      "description": "`hello` was refused; the hub closes the socket after this.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "refused"
        },
        "reason": {
          "description": "Why, for the companion's log or UI.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reason"
      ]
    },
    {
      "description": "The answer to `ping`.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "pong"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "description": "Run an action in the app; answered by a `response` with the same `id`.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "request"
        },
        "id": {
          "type": "string"
        },
        "action": {
          "description": "Companion-specific action id.",
          "type": "string"
        },
        "params": {
          "default": null
        }
      },
      "required": [
        "type",
        "id",
        "action"
      ]
    }
  ]
}
