{
  "name": "knobdeck-typescript",
  "private": true,
  "description": "npm workspace for KnobDeck's TypeScript packages (published one by one, see .github/workflows/publish-npm.yml)",
  "workspaces": [
    "protocol",
    "sdk",
    "companion"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "check": "npm run check --workspaces",
    "test": "npm test --workspaces --if-present",
    "versions": "node scripts-check-versions.mjs"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.3"
  }
}
